# Railway sets DATABASE_URL automatically when you add a Postgres plugin —
# you don't need to set it manually unless running locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zavqen

# generate a random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string

# your Vercel frontend URL(s), comma-separated. Use * only while testing.
CORS_ORIGINS=https://your-frontend.vercel.app

# this backend's own public Railway URL, used to build image/verify links
PUBLIC_BASE_URL=https://your-backend.up.railway.app

# your Vercel frontend URL, used to build the password-reset email link
FRONTEND_URL=https://your-frontend.vercel.app

# "production" hides dev-only verify/reset links from API responses
ENV=production

# optional: email registered with this address becomes admin automatically
BOOTSTRAP_ADMIN_EMAIL=you@example.com
